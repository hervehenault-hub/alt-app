# Variables d'environnement de l'app mobile — copier ce fichier en `.env` (jamais versionné).
# ⚠️ Tout ce qui est ici est EMBARQUÉ dans l'app et lisible par tous : uniquement des valeurs publiques.
# Ne JAMAIS mettre ici la clé secrète / « service » de Supabase.

# URL de l'API Supabase. En local (pnpm db:start) : http://127.0.0.1:54321
# (sur un téléphone physique, remplacer 127.0.0.1 par l'IP de l'ordinateur).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clé publique Supabase (« anon » ou « publishable »). En local : affichée par `pnpm db:start`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
