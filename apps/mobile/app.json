{
  "expo": {
    "name": "Alt.",
    "slug": "alt",
    "version": "0.1.0",
    "scheme": "alt",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "bundleIdentifier": "app.alt.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.alt.mobile"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
